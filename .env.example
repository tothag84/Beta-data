# --- Supabase ---
# From: https://app.supabase.com/project/<your-project>/settings/api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...                 # public, safe in clients
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...         # SERVER ONLY. Never ship to clients.

# --- Anthropic / Claude ---
# From: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7                  # default; override if needed

# --- Image generation (Google Imagen 4 via the Gemini API) ---
# Optional. When GEMINI_API_KEY is unset the pipeline still runs, but image_url
# stays null for that batch. Style is fixed in src/pipeline/images/style.ts.
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# IMAGE_MODEL=imagen-4.0-generate-001     # or imagen-4.0-fast-generate-001
# SUPABASE_IMAGE_BUCKET=trend-images

# --- Ingest sources ---
# Optional. Unauthenticated GitHub Search is 60 req/hr — fine for a daily
# cron. Set a token to raise the ceiling to 5000 req/hr.
# GITHUB_TOKEN=ghp_...

# --- Pipeline config ---
TRENDS_PER_RUN=5
FEEDBACK_WINDOW_DAYS=7
FEEDBACK_MIN_SWIPES=10
FEEDBACK_POSITIVE_THRESHOLD=0.8
